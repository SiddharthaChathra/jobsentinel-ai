{
  "name": "@jobsentinel/api",
  "version": "0.1.0",
  "private": true,
  "description": "JobSentinel AI backend: NestJS REST API (main.ts) and background worker (worker.ts)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env -r ts-node/register src/common/db/migrate.ts",
    "db:seed": "node --env-file=.env -r ts-node/register src/common/db/seed/index.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@jobsentinel/ai": "workspace:*",
    "@jobsentinel/config": "workspace:*",
    "@jobsentinel/types": "workspace:*",
    "@jobsentinel/validation": "workspace:*",
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/throttler": "^6.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
