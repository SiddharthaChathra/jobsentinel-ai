{
  "name": "@jobsentinel/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Pure, deterministic validation and normalization rules for JobSentinel AI (no I/O)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@jobsentinel/config": "workspace:*",
    "@jobsentinel/types": "workspace:*",
    "tldts": "^7.4.13"
  }
}
