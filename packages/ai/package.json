{
  "name": "@jobsentinel/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-independent AI service (Gemini / Claude / local) with Zod-validated structured outputs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@jobsentinel/config": "workspace:*",
    "@jobsentinel/types": "workspace:*",
    "zod": "^4.1.0"
  }
}
