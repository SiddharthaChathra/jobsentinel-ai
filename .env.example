# JobSentinel AI — environment template. Copy to .env (git-ignored) and fill in.
# Every variable is declared and validated in packages/config/src/env.ts.
# Processes: [web] Next.js (NEXT_PUBLIC_* only) · [api] REST API · [worker] background worker

# ───────── Shared ─────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000            # web origin (CORS, deep links)
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info                                # trace|debug|info|warn|error|fatal

# ───────── Supabase (Phase 2+) ─────────
SUPABASE_URL=                                 # https://xxxx.supabase.co
SUPABASE_ANON_KEY=                            # public key (also used by web)
SUPABASE_SERVICE_ROLE_KEY=                    # api + worker ONLY — never in the browser
SUPABASE_JWT_ISSUER=                          # optional; derived from SUPABASE_URL
DATABASE_URL=                                 # pooled connection (api/worker), Phase 3+
DATABASE_DIRECT_URL=                          # direct connection (migrations), Phase 3+
RESUME_BUCKET=resumes

# ───────── Web (public, browser-safe) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ───────── API ─────────
PORT=4000
WEB_ORIGIN=http://localhost:3000
ALLOWED_SIGNUP_EMAILS=*                       # comma list of emails, or * for anyone
ADMIN_EMAILS=                                 # comma list; admins manage sources/companies
ENABLE_API_DOCS=true                          # Swagger at /api/docs (off in prod)
RATE_LIMIT_PER_MIN=120

# ───────── Worker ─────────
WORKER_TICK_MS=60000
WORKER_MAX_SOURCES_PER_TICK=3
WORKER_SOURCE_CONCURRENCY=2
SOURCE_SCAN_TIMEOUT_MS=600000
HTTP_USER_AGENT="JobSentinelAI/0.1 (+mailto:you@example.com)"
HTTP_TIMEOUT_MS=15000
WORKER_HEALTH_PORT=                           # optional tiny /healthz for the worker
TELEGRAM_POLLING=true

# ───────── AI (Phase 2+) ─────────
AI_PROVIDER=gemini                            # gemini | claude | local
AI_FALLBACK_PROVIDERS=                        # e.g. claude
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.5-flash-lite
AI_CLAUDE_API_KEY=
AI_CLAUDE_MODEL=claude-haiku-4-5
AI_LOCAL_BASE_URL=http://localhost:11434
AI_LOCAL_MODEL=llama3.1
AI_REQUEST_TIMEOUT_MS=20000
AI_DAILY_CALL_BUDGET=500
AI_DAILY_TOKEN_BUDGET=1500000
AI_ALLOW_DETERMINISTIC_ALERTS=true

# ───────── Notifications (Phase 9) ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling                         # polling | webhook
TELEGRAM_WEBHOOK_SECRET=

# ───────── Sources (optional keys, Phase 4+) ─────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ───────── Tests ─────────
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
AI_LIVE_TESTS=0
