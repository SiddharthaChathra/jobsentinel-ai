{
  "name": "jobsentinel-ai",
  "version": "0.1.0",
  "private": true,
  "description": "JobSentinel AI — personal AI-powered job discovery, verification, matching and notification system",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @jobsentinel/web dev",
    "dev:api": "pnpm --filter @jobsentinel/api dev",
    "dev:worker": "pnpm --filter @jobsentinel/api dev:worker",
    "worker": "pnpm --filter @jobsentinel/api worker",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @jobsentinel/api db:generate",
    "db:migrate": "pnpm --filter @jobsentinel/api db:migrate",
    "db:seed": "pnpm --filter @jobsentinel/api db:seed",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "env:sync": "node scripts/sync-env.mjs",
    "check:files": "node scripts/check-local-files.mjs",
    "pretest": "node scripts/check-local-files.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
